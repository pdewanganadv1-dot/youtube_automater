# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
TARGET_AUDIENCE=United States

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# YOUTUBE_PRIVACY=private
# CARTOON_TTS=auto            # auto | piper | gemini
# CARTOON_VOICES=on
# SHORTS_CONTINUOUS=on
# SHORTS_SCHEDULE=10 */4 * * *
# SHORTS_MAX_PENDING=8
# SHORTS_PUBLISH_GAP_HOURS=4
# STORY_IMAGES=auto           # auto | pollinations | gemini | builtin
# POLLINATIONS_MODEL=flux
# STORY_FPS=30
# STORY_MAX_SECONDS=90
# STORY_X264_PRESET=veryfast
